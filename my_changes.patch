+def download(url, dest, size=0, sha256="", progress=None, cancelled=None, retries=8):
+    """Streams url to dest. progress(done, total). cancelled() -> True stops it.
+    A connection that drops half way (the file is big, Wi-Fi hiccups, GitHub closes the stream) does NOT fail the update:
+    the download goes on from where it stopped (HTTP Range), up to `retries` times in a row without progress."""
+    done, total, fails = 0, int(size or 0), 0
+    open(dest, "wb").close()
+    last_err = None
+    while True:
+        if cancelled is not None and cancelled():
+            raise UpdateError("cancelled")
+        if total and done >= total:
+            break
+        headers = {"User-Agent": 'ImageFixer-updater'}
+        if done:
+            headers["Range"] = "bytes=%d-" % done
+        before = done
+        try:
+            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as r:
+                if done and getattr(r, "status", 200) != 206:     # the server ignored Range: start again from 0
+                    done = 0
+                cr = r.headers.get("Content-Range") or ""
+                m = re.search(r"/(\d+)\s*$", cr)
+                clen = int(r.headers.get("Content-Length") or 0)
+                if m:
+                    total = int(m.group(1))
+                elif clen and not total:
+                    total = done + clen
+                with open(dest, "r+b") as f:
+                    f.seek(done)
+                    f.truncate()
+                    while True:
+                        if cancelled is not None and cancelled():
+                            raise UpdateError("cancelled")
+                        chunk = r.read(256 * 1024)
+                        if not chunk:
+                            break
+                        f.write(chunk)
+                        done += len(chunk)
+                        if progress is not None:
+                            progress(done, total)
+            last_err = None
+        except UpdateError:
+            raise
+        except urllib.error.HTTPError as e:
+            if e.code == 416 and total and done >= total:         # nothing left to ask for
+                break
+            last_err = "%s %s" % (e.code, e.reason)
+        except Exception as e:
+            last_err = getattr(e, "reason", None) or e
+        if total and done >= total:
+            break
+        if not total and last_err is None:
+            break                                                  # size unknown: a clean end of stream is the end
+        fails = 0 if done > before else fails + 1                  # only attempts that got nothing count
+        if fails > retries:
+            if last_err:
+                raise UpdateError("Download failed (%s)." % last_err)
+            raise UpdateError("The download is incomplete (%d of %d bytes)." % (done, total))
+        log("download stopped at %d of %d bytes (%s) - continuing" % (done, total, last_err or "stream ended early"))
+        for _ in range(min(2 * (fails + 1), 10)):                  # short wait, still cancellable
+            if cancelled is not None and cancelled():
+                raise UpdateError("cancelled")
+            time.sleep(0.5)
     if size and done != size:
         raise UpdateError("The download is incomplete (%d of %d bytes)." % (done, size))
